    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#06030B" />
    <meta name="description" content="AI-powered trading signal terminal" />

    <!-- Android / Chrome install (paired with the web manifest vite-plugin-pwa injects) -->
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <!-- iOS "Add to Home Screen" — Safari ignores the web manifest for most
         of this, so standalone display + icon + title need these meta tags. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Coco AI" />
    <meta name="mobile-web-app-capable" content="yes" />

    <title>Coco AI Terminal</title>
    <script type="module" crossorigin src="/assets/index-oKTLDPts.js"></script>
    <link rel="stylesheet" crossorigin href="/assets/index-QTSTxl9E.css">
  <link rel="manifest" href="/manifest.webmanifest"><script id="vite-plugin-pwa:register-sw" src="/registerSW.js"></script></head>
  <body>
    <div id="root"></div>
  </body>
</html>
